# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — use Doppler to manage secrets.
# Run locally: doppler run -- npm run dev
# (After: doppler login && doppler setup → select project njcoast, config dev)

# ── PostHog ──────────────────────────────────────────────────────────────────
# https://posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Google Maps ───────────────────────────────────────────────────────────────
# Enable: Maps JavaScript API in Google Cloud Console
# Restrict key to: njcoast.me (HTTP referrer) + Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom Map ID — create in Google Cloud Console → Maps Platform → Map Management
# Required for: AdvancedMarker (production) + cloud-based custom Cape May styling
# Steps: Create Map ID → Create Map Style → Associate style with Map ID
# Without this, a built-in coastal JSON style is used as fallback (dev only).
VITE_GOOGLE_MAPS_MAP_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# OR Google Cloud Console → APIs & Services → Credentials → API Key
# (restrict to Generative Language API + njcoast.me)
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vertex AI Search (Discovery Engine) ──────────────────────────────────────
# Covered by GenAI App Builder trial credit ($1,000).
# Setup in Google Cloud Console → Vertex AI → Search & Conversation → Apps
#
# 1. Enable Discovery Engine API
# 2. Create a Search App → create a data store (structured JSON or unstructured)
# 3. Import scenic locations data (export src/data/scenicLocations.js as JSONL)
# 4. Note your Project ID, Data Store ID
# 5. Create an API key restricted to: discoveryengine.googleapis.com + njcoast.me
#
# Covered SKUs used by this app:
#   Standard Search API Request Count    BADA-EE26-7BDA
#   Advanced Generative Answers           C232-DC00-D993
#   Grounded Generation                  C42C-2852-B25D
#   Ranking                              EE89-3EE8-2541
#   Data Index                           BC7D-6A97-90F8
VITE_VERTEX_SEARCH_PROJECT_ID=your-gcp-project-id
VITE_VERTEX_SEARCH_LOCATION=global
VITE_VERTEX_SEARCH_DATA_STORE=your-data-store-id
VITE_VERTEX_SEARCH_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

